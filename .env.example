# =============================================================================
# SmartFarm 2.0 - frontend environment variables (Vite)
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# =============================================================================

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Project Settings -> API -> anon public)
# The anon key is intentionally public: all row access is enforced by RLS policies.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# -----------------------------------------------------------------------------
# Optional feature flags
# -----------------------------------------------------------------------------

# Market data provider for the Market module.
#   edge  -> call the `market-data` Supabase Edge Function (recommended, keeps the
#            data.gov.in / AGMARKNET API key on the server)
#   table -> read only the rows already imported into the `market_prices` table
# Default when unset: edge (with automatic fallback to table if the function is
# not deployed). No market price is ever invented by the UI.
VITE_MARKET_PROVIDER=edge

# -----------------------------------------------------------------------------
# SERVER-SIDE SECRETS - DO NOT PUT THESE IN ANY VITE_* VARIABLE
# -----------------------------------------------------------------------------
# Vite embeds every VITE_* value into the browser bundle. The following secrets
# belong to Supabase Edge Functions and are set with:
#     supabase secrets set DATA_GOV_IN_API_KEY=xxxxx
#     supabase secrets set FARM_AI_API_KEY=xxxxx
#     supabase secrets set FARM_AI_MODEL=gpt-4o-mini
#     supabase secrets set FARM_AI_PROVIDER=openai
#
# DATA_GOV_IN_API_KEY   - data.gov.in API key for the AGMARKNET commodity feed
# FARM_AI_API_KEY       - optional LLM provider key used by the `farm-ai` function
# FARM_AI_MODEL         - optional model name for the `farm-ai` function
# FARM_AI_PROVIDER      - 'openai' (default) or 'gemini'
# SUPABASE_SERVICE_ROLE_KEY - provided automatically to edge functions; never
#                             expose it to the frontend.

